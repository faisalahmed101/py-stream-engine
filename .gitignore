# node-media-server: npm ci installs dependencies fresh INSIDE the
# image at build time (see Dockerfile) -- the host's own node_modules/
# (if it exists locally) must never be sent to Docker or used, since
# it may be built for a different OS/arch than the container.
node-media-server/node_modules/